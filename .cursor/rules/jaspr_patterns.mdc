# Jaspr Development: Code Patterns & Examples

**📖 This file provides detailed code examples for the rules in `.cursor/rules/jaspr_core.mdc`.**

## 🏗️ Component Patterns

### Component Granularity

```dart
// ✅ GOOD - Single cohesive widget for simple UI
class ProfilePage extends StatelessComponent {
  const ProfilePage({required this.user, super.key});
  final User user;

  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield div([
      // Header section
      header([
        img(src: user.avatarUrl, alt: 'Profile picture'),
        h1([text(user.name)]),
        p([text(user.bio)]),
      ], classes: 'profile-header'),

      // Stats section
      section([
        div([
          span([text('${user.followers}')], classes: 'stat-number'),
          span([text('Followers')], classes: 'stat-label'),
        ], classes: 'stat'),
      ], classes: 'profile-stats'),

      // Posts section
      section([
        h2([text('Recent Posts')]),
        ...user.posts.map((post) => PostCard(post: post)), // Reused component
      ], classes: 'profile-posts'),
    ], classes: 'profile-page');
  }
}

// ✅ GOOD - Extract when reused
class PostCard extends StatelessComponent {
  const PostCard({required this.post, super.key});
  final Post post;

  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield article([
      h3([text(post.title)]),
      p([text(post.excerpt)]),
      time([text(post.publishedAt.toString())]),
    ], classes: 'post-card');
  }
}

// ❌ AVOID - Over-granular widgets
class ProfileHeaderTitle extends StatelessComponent {
  const ProfileHeaderTitle({required this.name, super.key});
  final String name;

  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield h1([text(name)]); // Too simple to extract
  }
}
```

