## 🧪 Testing Patterns

```dart
// test/components/my_component_test.dart
import 'package:jaspr_test/jaspr_test.dart';
import 'package:test/test.dart';

void main() {
  group('MyComponent', () {
    testComponents('renders correctly', (tester) async {
      await tester.pumpComponent(MyComponent(data: testData));
      expect(find.text('Expected Text'), findsOneComponent);
    });

    testComponents('handles user interaction', (tester) async {
      await tester.pumpComponent(MyComponent(data: testData));
      await tester.tap(find.byText('Click Me'));
      await tester.pump();
      expect(find.text('Clicked!'), findsOneComponent);
    });
  });
}
```

## 🌐 Complete App Structure

```dart
// lib/app.dart
class App extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield Router(routes: [
      Route(path: '/', builder: (_, __) => HomePage()),
      Route(path: '/about', builder: (_, __) => AboutPage()),
      Route(path: '/blog/:slug', builder: (context, state) {
        final slug = state.pathParameters['slug']!;
        return BlogPostPage(slug: slug);
      }),
    ]);
  }
}

// lib/pages/home_page.dart
class HomePage extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield Document(
