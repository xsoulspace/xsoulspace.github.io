### CSS API Patterns

```dart
// Colors - Use Color() constructor
.color(Color(0xFF1a1a1a))

// Spacing - Use .only(), .symmetric(), .all()
.margin(Margin.only(top: 2.rem, bottom: 1.rem))
.padding(Padding.symmetric(horizontal: 1.5.rem))

// Position - Parameters for absolute/relative
.position(Position.absolute(top: 0.px, left: 0.px))

// Grid - Use GridTemplate with GridTracks
.gridTemplate(columns: GridTracks([
  GridTrack.fr(1),
  GridTrack.minmax(TrackSize.px(200), TrackSize.fr(1)),
]))

// Units - Use extension methods
2.rem, 16.px, 100.percent, 50.vh

// Transitions (type-safe)
.transition(Transition(
  property: 'all',
  duration: Duration(milliseconds: 300),
  timingFunction: TimingFunction.ease,
))
```

## 🔄 State Management Patterns

### Pattern 1: Local State (`StatefulComponent`)

Use for state contained within a single component.

```dart
class DynamicContent extends StatefulComponent {
  @override
  State<DynamicContent> createState() => _DynamicContentState();
}

class _DynamicContentState extends State<DynamicContent> {
  List<Item> items = [];
  bool isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadData();
  }

  Future<void> _loadData() async {
    try {
      final data = await ApiService.fetchUserData();
      setState(() {
        items = data;
        isLoading = false;
      });
    } catch (e) {
      setState(() {
        isLoading = false;
        // Handle error appropriately
      });
    }
  }

  @override
  Iterable<Component> build(BuildContext context) sync* {
    if (isLoading) {
      yield div([text('Loading...')], classes: 'loading');
      return;
    }

    yield div([
      ...items.map((item) => ItemCard(item: item)),
    ]);
  }
}
```

### Pattern 2: Server-Side Data Fetching

Use for fetching initial data on the server for fast page loads and SEO.

```dart
class BlogPage extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    // This `await` happens on the server during the rendering process.
    final posts = yield ssrFuture<List<Post>>(
      () => ApiService.fetchPosts(),
      id: 'posts', // Unique ID for hydration
    );

    yield div([
      ...posts.map((post) => PostCard(post: post)),
    ]);
  }
}
```

### Pattern 3: Global State (`ChangeNotifier`)

Use for simple global state shared across multiple components.

```dart
// lib/services/my_state_service.dart
import 'package:jaspr/jaspr.dart';

class MyStateService extends ChangeNotifier {
  MyStateService._();
  static final instance = MyStateService._();

  int _counter = 0;
  int get counter => _counter;

  void increment() {
    _counter++;
    // Prevent server-side frame scheduling errors
    if (kIsWeb) notifyListeners();
  }
}

// Usage in components
class CounterDisplay extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield ListenableBuilder(
      listenable: MyStateService.instance,
      builder: (context, child) {
        return p([
          text('Current count: ${MyStateService.instance.counter}'),
        ]);
      },
    );
  }
}

class CounterButton extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield button(
      [text('Increment')],
      events: {'click': (e) => MyStateService.instance.increment()},
    );
  }
}
```

### Pattern 4: Advanced Global State (`jaspr_riverpod`)

Use for complex state management with multiple dependencies and providers.

```dart
// Add to pubspec.yaml: dart pub add jaspr_riverpod
import 'package:jaspr_riverpod/jaspr_riverpod.dart';

final userProvider = StateProvider<User?>((ref) => null);

class UserProfile extends ConsumerComponent {
  @override
  Component build(BuildContext context, WidgetRef ref) {
    final user = ref.watch(userProvider);
    return div([
      if (user != null) text('Welcome, ${user.name}') else text('Not logged in'),
    ]);
  }
}
```

## 🧪 Testing Patterns

```dart
// test/components/my_component_test.dart
import 'package:jaspr_test/jaspr_test.dart';
import 'package:test/test.dart';
import 'package:my_app/components/my_component.dart';

void main() {
  group('MyComponent', () {
    testComponents('renders correctly with initial data', (tester) async {
      await tester.pumpComponent(MyComponent(data: 'test'));

      expect(find.text('Initial State'), findsOneComponent);
    });

    testComponents('updates state on user interaction', (tester) async {
      await tester.pumpComponent(MyComponent(data: 'test'));

      // Simulate a button click
      await tester.click(find.tag('button'));
      await tester.pump(); // Re-render the component

      // Verify the component updated
      expect(find.text('Updated State'), findsOneComponent);
    });
  });
}
```

## 🌐 App Structure, SEO & Routing

This example shows how to structure a multi-page app with routing and proper SEO metadata using the `Document` component.

```dart
// lib/app.dart
import 'package:jaspr/jaspr.dart';
import 'package:jaspr_router/jaspr_router.dart';

// Pages
import 'pages/home.dart';
import 'pages/about.dart';
import 'pages/blog_post.dart';

class App extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield Router(
      routes: [
        Route(path: '/', builder: (_, __) => HomePage()),
        Route(path: '/about', builder: (_, __) => AboutPage()),
        Route(
          path: '/blog/:slug',
          builder: (context, state) {
            final slug = state.pathParameters['slug']!;
            return BlogPostPage(slug: slug);
          },
        ),
      ],
    );
  }
}

// lib/pages/home.dart
class HomePage extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield Document(
      title: 'Home - My Awesome Jaspr Site',
      meta: {
        'description': 'Welcome to my amazing website built with Jaspr.',
        'og:title': 'My Awesome Jaspr Site',
        'og:description': 'Check out this site built with Dart and Jaspr.',
        'og:image': 'https://example.com/images/og-image.jpg',
        'twitter:card': 'summary_large_image',
      },
      body: [
        div([
          header([
            nav([
              a(href: '/', [text('Home')]),
              a(href: '/about', [text('About')]),
              a(href: '/blog/my-first-post', [text('Blog')]),
            ]),
          ]),
          main([
            h1([text('Welcome to the Homepage')]),
            p([
              text('This is the main content of the homepage.'),
            ]),
          ]),
          footer([
            p([text('© 2024 My Awesome Site')]),
          ]),
        ], classes: 'container'),
      ],
    );
  }
}
```

## 🔄 Real-World Refactoring Patterns

### Pattern: Safe Component API Changes

```dart
// ❌ BEFORE - Individual parameters (hard to maintain)
class ProjectCard extends StatelessComponent {
  const ProjectCard({
    required this.title,
    required this.description,
    required this.imageUrl,
    required this.tags,
    super.key,
  });

  final String title;
  final String description;
  final String imageUrl;
  final List<String> tags;

  // ... rest of component
}

// ✅ AFTER - Model-based (easier to maintain)
class ProjectCard extends StatelessComponent {
  const ProjectCard({
    required this.project,
    super.key,
  });

  final ProjectModel project;  // Single source of truth

  @override
  Iterable<Component> build(BuildContext context) sync* {
    // Access via project.title, project.description, etc.
    yield article([
      h3([text(project.title)]),
      p([text(project.description)]),
      // Handle nullable/optional fields gracefully
      if (project.imageUrl != null)
        img(src: project.imageUrl!, alt: project.title),
    ], classes: 'project-card');
  }
}

// ✅ MIGRATION STRATEGY - Update usage sites systematically
// 1. First, update the component definition
// 2. Then update all usage sites in one commit
// 3. Test each file as you go

// Old usage:
// ProjectCard(title: 'My Project', description: '...', ...)

// New usage:
// ProjectCard(project: ProjectModel(...))
```

### Pattern: Bento Grid with Visual Grouping

```dart
// ✅ REAL EXAMPLE - Proven bento grid pattern
class BentoGrid extends StatelessComponent {
  const BentoGrid({required this.projects, super.key});
  final List<ProjectModel> projects;

  @override
  Iterable<Component> build(BuildContext context) sync* {
    // Group projects by category
    final groups = <String, List<ProjectModel>>{};
    for (final project in projects) {
      final category = project.category ?? 'Other';
      groups.putIfAbsent(category, () => []).add(project);
    }

    yield div(classes: 'bento-grid', [
      // Create visual groups with headers
      for (final entry in groups.entries) ...[
        _buildGroup(entry.key, entry.value),
      ],
    ]);
  }

  Component _buildGroup(String category, List<ProjectModel> projects) {
    final groupInfo = _getGroupInfo(category);

    return section(classes: 'bento-group', [
      // Group header with icon, title, and count
      header(classes: 'group-header', [
        div(classes: 'group-header-content', [
          span(classes: 'group-icon', [text(groupInfo.icon)]),
          div(classes: 'group-text', [
            h2(classes: 'group-title', [text(groupInfo.title)]),
            p(classes: 'group-subtitle', [text(groupInfo.subtitle)]),
          ]),
          span(classes: 'group-count', [text('${projects.length}')]),
        ]),
      ]),

      // Responsive grid of project cards
      div(classes: 'group-grid', [
        for (final project in projects)
          ProjectCard(project: project),
      ]),
    ]);
  }
}
```

## 🎨 CSS Gotchas & Solutions

```dart
// ❌ COMMON MISTAKES
css('.my-class')
  .lineHeight(1.2)        // Wrong - needs .px
  .zIndex(10)             // Wrong - needs ZIndex wrapper
  .color(Colors.blue)     // Wrong - use Color(0xFF...)
  .styles(raw: {          // Wrong - missing const
    'animation': 'spin 1s',
  });

// ✅ CORRECT SOLUTIONS
css('.my-class')
  .lineHeight(1.2.px)                    // Correct
  .zIndex(const ZIndex(10))              // Correct
  .color(Color(0xFF2196F3))              // Correct
  .styles(raw: const {                   // Correct - const required
    'animation': 'spin 1s linear infinite',
    'backdrop-filter': 'blur(10px)',
    'transform': 'translateY(-2px)',
  });
```

## 🔄 State Management Patterns

### Pattern 3: Global State (`ChangeNotifier`) - Real Implementation

```dart
// ✅ PROVEN PATTERN - This actually works in production
class ProjectsService extends ChangeNotifier {
  ProjectsService._();
  static final instance = ProjectsService._();

  List<ProjectModel> _projects = [];
  bool _isLoading = false;

  List<ProjectModel> get projects => _projects;
  bool get isLoading => _isLoading;

  Future<void> fetchProjects() async {
    _isLoading = true;
    // CRITICAL: Only notify on client to prevent server frame scheduling errors
    if (kIsWeb) notifyListeners();

    try {
      final response = await http.get(Uri.parse('/assets/data/projects.yaml'));
      if (response.statusCode == 200) {
        final List<dynamic> data = loadYaml(response.body);
        _projects = data.map((json) => ProjectModel.fromMap(json)).toList();
      }
    } catch (e) {
      print('Error loading projects: $e');
    } finally {
      _isLoading = false;
      // CRITICAL: Only notify on client
      if (kIsWeb) notifyListeners();
    }
  }
}

// Usage with InheritedComponent (proven pattern)
class InheritedProjectsService extends InheritedComponent {
  const InheritedProjectsService({
    required this.service,
    required super.child,
    super.key,
  });

  final ProjectsService service;

  static ProjectsService of(BuildContext context) {
    final inherited = context
        .dependOnInheritedComponentOfExactType<InheritedProjectsService>();
    return inherited?.service ?? ProjectsService.instance;
  }

  @override
  bool updateShouldNotify(InheritedProjectsService oldWidget) {
    return service != oldWidget.service;
  }
}

// Usage in components with server/client conditional rendering
class MyComponent extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    final projectsService = InheritedProjectsService.of(context);

    yield main_([
      // CRITICAL: Different rendering for server vs client
      if (kIsWeb)
        ListenableBuilder(
          listenable: projectsService,
          builder: (context) sync* {
            yield* _buildContent(projectsService);
          },
        )
      else
        // Server-side: render directly without ListenableBuilder
        ..._buildContent(projectsService),
    ]);
  }

  Iterable<Component> _buildContent(ProjectsService service) sync* {
    if (service.isLoading) {
      yield div([text('Loading...')], classes: 'loading');
      return;
    }

    yield div([
      for (final project in service.projects)
        ProjectCard(project: project),
    ]);
  }
}
```

